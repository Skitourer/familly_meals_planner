{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "simple",
	"include-component-in-tag": false,
	"changelog-sections": [
		{
			"type": "feat",
			"section": "Nouveautés"
		},
		{
			"type": "fix",
			"section": "Corrections"
		},
		{
			"type": "perf",
			"section": "Performances"
		},
		{
			"type": "docs",
			"section": "Documentation"
		},
		{
			"type": "chore",
			"section": "Maintenance",
			"hidden": true
		}
	],
	"packages": {
		".": {
			"extra-files": [
				{
					"type": "toml",
					"path": "backend/pyproject.toml",
					"jsonpath": "$.project.version"
				},
				{
					"type": "toml",
					"path": "backend/uv.lock",
					"jsonpath": "$.package[?(@.name==='repas')].version"
				},
				{
					"type": "json",
					"path": "frontend/package.json",
					"jsonpath": "$.version"
				},
				"backend/src/repas/application.py"
			]
		}
	}
}
