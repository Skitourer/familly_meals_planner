# Copier en .env et adapter. Toutes les variables sont facultatives en développement.

# Mot de passe du compte adulte initial « famille », créé au premier démarrage
# quand la base ne contient aucun compte (À CHANGER, puis changeable dans l'application).
REPAS_MOT_DE_PASSE=famille

# Clé de signature des cookies (obligatoire en production : la valeur ci-dessous y est
# refusée au démarrage) : chaîne aléatoire longue, par exemple
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
REPAS_CLE_SECRETE=a-changer-en-production

# Cookie réservé au HTTPS (à activer derrière un reverse proxy TLS).
REPAS_COOKIE_SECURISE=false

# Emplacements (valeurs par défaut adaptées au développement).
# REPAS_DOSSIER_DONNEES=./donnees
# REPAS_BASE_DE_DONNEES=./donnees/local/repas.db
# REPAS_DOSSIER_INTERFACE=./frontend/build
